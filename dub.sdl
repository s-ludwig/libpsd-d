name "libpsd"
description "D bindings and binaries for libpsd"
license "LGPL-2.1"
copyright "Copyright (c) 2004-2007, www.graphest.com; Copyright (c) 2020-2026, Sönke Ludwig"

targetName "psd"

configuration "android" {
	platforms "android"
	lflags "-L${PACKAGE_DIR}/lib/android-arm64" platform="android-aarch64"
	libs "psd" platform="linux"
}

configuration "default" {
	sourceFiles "lib/windows-x86/psd.lib" platform="windows-x86"
	sourceFiles "lib/windows-x86_64/psd.lib" platform="windows-x86_64"
	lflags "-L${PACKAGE_DIR}/lib/linux-x86_64" platform="linux-x86_64"
	lflags "-L${PACKAGE_DIR}/lib/linux-arm64" platform="linux-aarch64"
	libs "psd" platform="linux"
	sourceFiles "lib/macos-x86_64/libpsd.a" platform="osx-x86_64"
	sourceFiles "lib/macos-arm64/libpsd.a" platform="osx-aarch64"
	sourceFiles "lib/ios-arm64/libpsd.a" platform="ios-aarch64"
	sourceFiles "lib/ios-simulator-x86_64/libpsd.a" platform="ios-x86_64"
}
